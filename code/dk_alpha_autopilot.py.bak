ROOT = Path(r"C:\LumaTrader\INSTITUTIONAL_STACK_V2")
CODE_DIR = ROOT / "code"
SPORTS_DIR = ROOT / "sports_data"
OUT_DIR = ROOT / "out" / "sports_intelligence"
