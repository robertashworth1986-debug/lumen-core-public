MARKET_PRIMARY = "h2h,spreads,totals"
MARKET_FALLBACK = "h2h"

ALPHA_BOARD_JSON = OUT_DIR / "_dk_alpha_board.json"
ALPHA_BOARD_CSV = OUT_DIR / "_dk_alpha_board.csv"
