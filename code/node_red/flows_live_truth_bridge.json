  {
    "id": "a444444444444444",
    "type": "function",
    "z": "f2e0d3cba1b44410",
    "name": "Route Scene Cue",
    "func": "const p = msg.payload || {};\nconst mode = String(p.mode || 'adaptive_hold');\nconst score = Number(p.lattice_score || 0);\nlet cue = 'adaptive_hold';\nlet intensity = 0.35;\nif (mode === 'aggressive_expansion' && score >= 0.72) { cue = 'institutional_signal'; intensity = 0.92; }\nelse if (mode === 'targeted_expansion' && score >= 0.56) { cue = 'harmonic_peak'; intensity = 0.72; }\nelse if (mode === 'selective_execution' && score >= 0.42) { cue = 'focused_scan'; intensity = 0.54; }\nmsg.payload = {\n  scene: 'core',\n  cue: cue,\n  intensity: intensity,\n  detail: { mode: mode, lattice_score: score, geometry: p.geometry || {} }\n};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 650,
    "y": 150,
    "wires": [["a555555555555555", "a666666666666666"]]
  },
