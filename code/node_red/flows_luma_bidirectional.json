  {
    "id": "inv_cue_logic",
    "type": "function",
    "z": "f5db0337a411f4c7",
    "name": "Investor-grade cue logic",
    "func": "const b = msg.payload || {};\nconst h = b.headline || {};\nconst sharpe = Number(h.sharpe || 0);\nconst pf = Number(h.profit_factor || 0);\nconst pnl = Number(h.net_pnl_usd || 0);\nconst harmScore = Number(h.harmonic_top_score || 0);\nconst svc = String(h.services_up || '0/0').split('/');\nconst svcUp = Number(svc[0] || 0);\nconst svcTotal = Number(svc[1] || 0);\n\nlet cue = 'idle_breathe';\nlet intensity = 0.3;\nlet scene = 'core';\nlet visualHint = 'investor';\n\nif (pnl < -50) { cue = 'critical_warning'; intensity = 1.0; scene = 'alert'; visualHint = 'cinematic'; }\nelse if (pnl < 0)  { cue = 'warning_pulse'; intensity = 0.75; visualHint = 'cinematic'; }\nelse if (sharpe > 8 && pf > 2) { cue = 'institutional_signal'; intensity = 0.9; scene = 'harmonic'; visualHint = 'investor'; }\nelse if (harmScore > 70) { cue = 'harmonic_peak'; intensity = 0.85; scene = 'harmonic'; visualHint = 'cinematic'; }\nelse if (pnl > 0 && sharpe > 3) { cue = 'success_pulse'; intensity = 0.6; visualHint = 'investor'; }\nelse if (svcTotal > 0 && svcUp < svcTotal) { cue = 'service_degraded'; intensity = 0.8; scene = 'alert'; visualHint = 'cinematic'; }\n\nmsg.payload = {\n  scene,\n  cue,\n  intensity,\n  detail: {\n    sharpe,\n    profit_factor: pf,\n    net_pnl: pnl,\n    harmonic_score: harmScore,\n    services_up: h.services_up,\n    top_lane: h.infra_top_lane,\n    source: 'investor_brief',\n    visual_profile_hint: visualHint\n  }\n};\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 650,
    "y": 360,
    "wires": [["inv_post_cue", "inv_log_event"]]
  },
