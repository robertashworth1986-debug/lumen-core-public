  {
    "id": "harm_cue_filter",
    "type": "function",
    "z": "f5db0337a411f4c7",
    "name": "Harmonic spike filter",
    "func": "const d = msg.payload || {};\nconst top = (d.top_signals || [])[0];\nif (!top) return null;\nconst score = (top.flowform || {}).hybrid_harmonic_score || 0;\nif (score < 60) return null; // only fire on strong signals\nmsg.payload = {\n  scene: 'harmonic',\n  cue: 'harmonic_peak',\n  intensity: Math.min(score / 100, 1.0),\n  detail: {\n    asset: top.asset,\n    domain: top.domain,\n    score,\n    edge_pct: top.edge_pct,\n    source: 'harmonic_feed',\n    visual_profile_hint: 'cinematic'\n  }\n};\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
