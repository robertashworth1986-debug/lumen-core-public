  {
    "id": "60ea8ef8ae281986",
    "type": "function",
    "z": "f5db0337a411f4c7",
    "name": "Auto cue on pnl",
    "func": "const p = msg.payload || {};\nconst pnl = p.paper && typeof p.paper.net_pnl === 'number' ? p.paper.net_pnl : 0;\nconst cue = pnl < 0 ? 'warning_pulse' : 'success_pulse';\nmsg.payload = {\n  scene: 'core',\n  cue,\n  intensity: pnl < 0 ? 0.85 : 0.45,\n  detail: {\n    top_lane: p.infra ? p.infra.top_lane : 'n/a',\n    top_artist: p.scout ? p.scout.top_artist : 'n/a',\n    source: 'snapshot_auto',\n    visual_profile_hint: cue === 'warning_pulse' ? 'cinematic' : 'investor'\n  }\n};\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 560,
