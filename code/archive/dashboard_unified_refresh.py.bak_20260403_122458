def build_chain():
    files = [
        LIVE_REGISTRY,
        LIVE_SOURCES,
        PAPER_STATE,
        PAPER_LEDGER,
        PAPER_RUNTIME,
        ROLLING_JSON,
        SECTOR_JSON,
        ALPACA_HTML,
        INFRA_HTML,
    ]
    chain = {"generated_utc": now_iso(), "files": []}
    for f in files:
        if f.exists():
            chain["files"].append({
                "path": str(f),
                "sha256": sha256_file(f),
                "size_bytes": f.stat().st_size,
            })
    write_json(CHAIN_JSON, chain)

def loop():
    while True:
        try:
            p = build_paper_metrics()
            m = build_infra_metrics()
            build_alpaca_dashboard(p)
            build_infra_dashboard(m, p)
            build_chain()
            print(f"[{now_iso()}] unified dashboards refreshed")
        except Exception as e:
            print(f"[{now_iso()}] refresh error: {e}")
        time.sleep(60)

if __name__ == "__main__":
    loop()
