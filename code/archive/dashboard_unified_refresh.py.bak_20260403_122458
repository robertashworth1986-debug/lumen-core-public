def now_iso():
    return datetime.now(timezone.utc).isoformat()

def safe_float(v, default=0.0):
    try:
        if v is None:
            return default
        if isinstance(v, bool):
            return float(v)
        s = str(v).strip().replace(",", "")
        if s == "":
            return default
        return float(s)
    except Exception:
        return default

def safe_int(v, default=0):
    try:
        return int(round(safe_float(v, default)))
    except Exception:
        return default

def read_json(path: Path, default):
    try:
        if path.exists():
            return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        pass
    return default

def read_jsonl(path: Path):
    rows = []
    try:
        if not path.exists():
            return rows
        for line in path.read_text(encoding="utf-8", errors="ignore").splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                rows.append(json.loads(line))
            except Exception:
                continue
    except Exception:
        pass
    return rows

def write_json(path: Path, obj):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(obj, indent=2), encoding="utf-8")

def sha256_file(path: Path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(8192), b""):
            h.update(chunk)
    return h.hexdigest()

def extract_ts(obj):
    for k in ("timestamp", "generated_utc", "last_probe_utc", "ts", "time"):
        v = obj.get(k)
        if v is None:
            continue
        try:
            if isinstance(v, (int, float)):
                return float(v)
            s = str(v).replace("Z", "+00:00")
            return datetime.fromisoformat(s).timestamp()
        except Exception:
            continue
    return None

def compute_sharpe(equity_curve):
    if len(equity_curve) < 3:
        return 0.0
    rets = []
    prev = None
    for x in equity_curve:
        x = safe_float(x)
        if prev and prev != 0:
            rets.append((x - prev) / prev)
        prev = x
    if len(rets) < 2:
        return 0.0
    mean_r = statistics.mean(rets)
    stdev_r = statistics.pstdev(rets)
    if stdev_r == 0:
        return 0.0
    return round((mean_r / stdev_r) * math.sqrt(len(rets)), 4)

def compute_max_drawdown(equity_curve):
    if not equity_curve:
        return 0.0
    peak = safe_float(equity_curve[0], 0.0)
    max_dd = 0.0
    for x in equity_curve:
        x = safe_float(x, 0.0)
        peak = max(peak, x)
        if peak > 0:
            dd = (peak - x) / peak
            max_dd = max(max_dd, dd)
    return round(max_dd, 6)

def horizonize(per_hour):
    return {
        "per_hour": round(per_hour, 2),
        "per_day": round(per_hour * 24.0, 2),
        "per_week": round(per_hour * 24.0 * 7.0, 2),
        "per_month": round(per_hour * 24.0 * 30.0, 2),
        "per_year": round(per_hour * 24.0 * 365.0, 2),
    }

def load_live_sources():
    registry = read_json(LIVE_REGISTRY, {"sources": []})
    cfg = read_json(LIVE_SOURCES, {})
    return registry, cfg

def build_paper_metrics():
    state = read_json(PAPER_STATE, {})
    runtime = read_json(PAPER_RUNTIME, {})
    ledger = read_jsonl(PAPER_LEDGER)

    starting = safe_float(state.get("starting_capital") or state.get("starting_equity") or runtime.get("starting_capital") or 100000.0, 100000.0)
    equity = safe_float(
        state.get("current_equity")
        or state.get("equity")
        or runtime.get("current_equity")
        or runtime.get("equity")
        or starting,
        starting
    )

    wins = safe_int(state.get("wins") or runtime.get("wins") or 0)
    losses = safe_int(state.get("losses") or runtime.get("losses") or 0)
    trades = safe_int(state.get("trades") or runtime.get("trades") or len(ledger))
    last_symbol = str(state.get("last_symbol") or runtime.get("last_symbol") or "")
    last_side = str(state.get("last_side") or runtime.get("last_side") or "")

    equity_curve = []
    pnl_values = []
    ts_values = []

    for obj in ledger[-500:]:
        eq = obj.get("equity_after")
        if eq is None:
            eq = obj.get("equity")
        pnl = obj.get("pnl")
        if pnl is None:
            pnl = obj.get("profit")
        ts = extract_ts(obj)

        if eq is not None:
            equity_curve.append(safe_float(eq))
        if pnl is not None:
            pnl_values.append(safe_float(pnl))
        if ts is not None:
            ts_values.append(ts)

        if not last_symbol and obj.get("symbol"):
            last_symbol = str(obj.get("symbol"))
        if not last_side and obj.get("side"):
            last_side = str(obj.get("side"))

    if not equity_curve:
        equity_curve = [starting, equity]

    profit = round(equity - starting, 2)
    sharpe = compute_sharpe(equity_curve)
    max_dd = compute_max_drawdown(equity_curve)
    win_rate = round((wins / max(trades, 1)) * 100.0, 2)
    avg_pnl = round(statistics.mean(pnl_values), 4) if pnl_values else 0.0

    elapsed_hours = 1.0
    if len(ts_values) >= 2:
        elapsed_sec = max(ts_values) - min(ts_values)
        if elapsed_sec > 0:
            elapsed_hours = max(elapsed_sec / 3600.0, 1.0 / 60.0)

    profit_per_hour = profit / elapsed_hours
    rolling = horizonize(profit_per_hour)

    metrics = {
        "generated_utc": now_iso(),
        "starting_capital": round(starting, 2),
        "current_equity": round(equity, 2),
        "paper_profit": profit,
        "wins": wins,
        "losses": losses,
        "trades": trades,
        "last_symbol": last_symbol,
        "last_side": last_side,
        "sharpe": sharpe,
        "max_drawdown_pct": round(max_dd * 100.0, 4),
        "win_rate_pct": win_rate,
        "avg_pnl": avg_pnl,
        "elapsed_hours": round(elapsed_hours, 4),
        "rolling": rolling,
        "equity_points": len(equity_curve),
        "ledger_rows_seen": len(ledger),
    }
    write_json(ROLLING_JSON, metrics)
    return metrics

