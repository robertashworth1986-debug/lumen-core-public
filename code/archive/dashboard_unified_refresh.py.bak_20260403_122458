def build_infra_metrics():
    registry, cfg = load_live_sources()
    sources = registry.get("sources", [])

    sector_rows = {}
    source_rows = []

    for s in sources:
        source = str(s.get("source") or "UNKNOWN")
        sector = str(s.get("sector") or "unmapped")
        status = str(s.get("status") or "UNKNOWN")
        rows = safe_int(s.get("rows") or 0)
        last_probe = str(s.get("last_probe_utc") or "")
        env_name = str(s.get("env") or "")

        base = SECTOR_BASE_PER_HOUR.get(sector, 250.0)
        gain_pct = 1.0 + min(rows, 240) / 100.0 if rows > 0 else 1.0
        est_hour = round(base * gain_pct, 2)

        sector_rows.setdefault(sector, {
            "sector": sector,
            "live_sources": 0,
            "rows": 0,
            "estimated_hourly_value": 0.0,
            "sources": []
        })

        sector_rows[sector]["live_sources"] += 1
        sector_rows[sector]["rows"] += rows
        sector_rows[sector]["estimated_hourly_value"] += est_hour
        sector_rows[sector]["sources"].append(source)

        source_rows.append({
            "source": source,
            "sector": sector,
            "status": status,
            "rows": rows,
            "last_probe_utc": last_probe,
            "env": env_name,
            "estimated_hourly_value": est_hour,
            "horizons": horizonize(est_hour),
        })

    sector_table = []
    for sector, obj in sorted(sector_rows.items(), key=lambda kv: kv[1]["estimated_hourly_value"], reverse=True):
        h = horizonize(obj["estimated_hourly_value"])
        sector_table.append({
            "sector": sector,
            "live_sources": obj["live_sources"],
            "rows": obj["rows"],
            "estimated_hourly_value": round(obj["estimated_hourly_value"], 2),
            **h,
            "sources": obj["sources"],
        })

    total_hour = round(sum(x["estimated_hourly_value"] for x in sector_table), 2)
    top_sector = sector_table[0]["sector"] if sector_table else "none"

    matrix = {
        "generated_utc": now_iso(),
        "enabled_sources": len(source_rows),
        "sector_count": len(sector_table),
        "estimated_hourly_preserved_value": total_hour,
        "top_sector": top_sector,
        "sectors": sector_table,
        "sources": source_rows,
    }
    write_json(SECTOR_JSON, matrix)
    return matrix

