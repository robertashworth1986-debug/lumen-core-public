# Caddyfile for lumen-core.ai
# Auto-HTTPS via Let's Encrypt.

{
    email hello@lumen-core.ai
}

# Main public domain + gateway API/ws
lumen-core.ai, www.lumen-core.ai {
    encode gzip zstd
    root * /var/www/lumatrader

    # Route API and websocket traffic to gateway.
    reverse_proxy /api/* 127.0.0.1:8787
    reverse_proxy /ws/live 127.0.0.1:8787
    reverse_proxy /health 127.0.0.1:8787

    @nginxHealth path /nginx-health
    respond @nginxHealth "ok" 200

    file_server

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "interest-cohort=()"
        -Server
    }

    log {
        output file /var/log/caddy/lumen-core.log {
            roll_size 50mb
            roll_keep 7
        }
    }
}

# Investor app dashboard (Panel on :5016)
app.lumen-core.ai {
    basicauth {
        investor JDJhJDE0JG13RGFKNlNUZjFZbk1uM2Z6VC9PTk9Va3R3WTlvOFF0cXhpUTlTSFlsRy9yelV6Tll0VnNh
    }

    encode gzip zstd
    reverse_proxy 127.0.0.1:5016 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Frame-Options "SAMEORIGIN"
    }
}

# Research/scout dashboard (Panel on :5017)
research.lumen-core.ai {
    basicauth {
        investor JDJhJDE0JG13RGFKNlNUZjFZbk1uM2Z6VC9PTk9Va3R3WTlvOFF0cXhpUTlTSFlsRy9yelV6Tll0VnNh
    }

    encode gzip zstd
    reverse_proxy 127.0.0.1:5017 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
