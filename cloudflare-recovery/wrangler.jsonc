{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lumencore-recovery-preview",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-21",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "none",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
