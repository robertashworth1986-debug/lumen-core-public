      "default": "RETAIN",
      "release_requires": [
        "verified_backup_and_restore_evidence",
        "retention_owner_authority",
        "legal_grant_audit_settlement_and_reproducibility_hold_review",
        "dependency_review",
        "exact_action_time_human_unlock"
      ]
    },
    {
      "rule_id": "runtime_is_redeploy_not_cleanup",
      "content_classes": [
        "runtime"
      ],
      "default": "RETAIN",
      "release_requires": [
        "reproducible_locked_build",
        "rollback_plan",
        "capacity_headroom",
        "exact_action_time_human_unlock"
      ]
    },
    {
      "rule_id": "logs_require_custody_review",
      "content_classes": [
        "logs"
      ],
      "default": "RETAIN",
