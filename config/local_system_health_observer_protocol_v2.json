{
  "schema": "luma.local_system_health_observer_protocol.v2",
  "protocol_id": "local_system_health_observer_v2",
  "protocol_version": "2.0.0",
  "frozen_at_utc": "2026-07-14T10:00:00Z",
  "mode": "observation_only",
  "evidence_maturity": "local_operational_observation",
  "cadence": {
    "interval_minutes": 5,
    "single_run_timeout_minutes": 4,
    "docker_unavailable_backoff_minutes": 60
  },
  "observations": {
    "cpu": {
      "enabled": true,
      "sample_seconds": 1.0,
      "exclude_collector_process_time": true
    },
    "uptime": {
      "enabled": true
    },
    "memory": {
      "enabled": true,
      "exclude_collector_working_set": true
    },
    "disk": {
      "enabled": true,
      "volume_aliases_only": true,
      "exclude_collector_output_bytes": true
    },
    "battery": {
      "enabled": true
    },
    "windows_update_service": {
      "enabled": true,
      "service_alias": "windows_update_service",
      "collect_status": true,
      "collect_start_mode": true,
      "mutation_allowed": false
    },
    "docker": {
      "enabled": true,
      "daemon_query_limit_per_eligible_run": 1,
      "container_inventory_query_limit_per_eligible_run": 1,
      "include_all_states": true,
      "public_safe_container_names": [
        "prometheus",
        "grafana",
        "lumen-exporter",
        "node_exporter"
      ],
      "container_mutation_allowed": false
    }
  },
  "mutation_policy": {
    "start_or_restart_services": false,
    "start_or_restart_containers": false,
    "install_or_upgrade_software": false,
    "change_accounts_or_credentials": false,
    "external_send": false
  },
  "output_contract": {
    "latest_filename": "health_observer_v2_latest.json",
    "daily_segment_prefix": "health_observer_v2_",
    "daily_segment_suffix": ".jsonl",
    "single_writer_lock_filename": ".health_observer_v2.lock",
    "absolute_paths_allowed": false,
    "usernames_allowed": false,
    "credentials_allowed": false,
    "unconfigured_container_details_allowed": false,
    "self_observation_allowed": false
  },
  "integrity": {
    "hash_algorithm": "sha256",
    "canonical_json": "utf8_sorted_keys_compact_no_nan",
    "append_flush_fsync_required": true,
    "atomic_latest_replace_required": true,
    "monotonic_sequence_required": true,
    "prior_event_hash_required": true,
    "snapshot_content_hash_required": true,
    "protocol_hash_required": true,
    "collector_script_hash_required": true,
    "task_staging_script_hash_required": true
  },
  "readiness": {
    "horizons_observed_v2_dates": [
      30,
      90,
      180
    ],
    "require_distinct_utc_dates_with_v2_observations": true,
