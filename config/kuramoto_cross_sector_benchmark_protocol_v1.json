      "rerun_command": "python code/eia_grid_wave_champion_benchmark.py --skip-network",
      "evidence_class": "protocol_frozen_measured_public_data",
      "required_candidate_id": "kuramoto_phase_coupling",
      "required_external_replication": true
    }
  ],
