{
  "schema": "lumencore.kuramoto_cross_sector_benchmark_protocol.v1",
  "protocol_id": "KURAMOTO_CROSS_SECTOR_20260726",
  "version": 1,
  "frozen_date_utc": "2026-07-26",
  "purpose": "Measure an implemented Kuramoto seasonal-oscillator forecast against protocol-matched one-step baselines on explicit public-data snapshots, then identify where additional prospective validation is justified.",
  "candidate": {
    "id": "kuramoto_phase_coupling",
    "definition": "Fit fixed cadence-specific seasonal oscillators on history available before each origin, advance their phases one step with the Kuramoto equation using Euler integration, and reconstruct the next value.",
    "coupling": 0.01,
    "ridge": 0.0001,
    "post_result_tuning_allowed": false
  },
  "baseline_scope": {
    "statement": "Every dependency-free, univariate, one-step numeric baseline currently implemented in the governed runner and able to consume the identical history window is executed. Domain-specific operator, topology, multivariate, or package-fallback methods are excluded unless they have an exact protocol-matched implementation.",
    "not_a_global_all_algorithms_claim": true,
    "excluded_classes": [
      "operator or buyer incumbent not present in the local snapshot",
      "power-flow, OPF, routing, CFD, and other domain-specific solvers",
      "multivariate methods without the same covariate contract",
      "package-dependent methods that silently substitute a different estimator",
      "neural models without a frozen compute and tuning budget"
    ]
  },
  "baselines": [
    {
      "id": "naive_last",
      "definition": "Forecast the most recent observed value."
    },
    {
      "id": "seasonal_naive",
      "definition": "Forecast the value at the cadence-specific seasonal lag."
    },
    {
      "id": "rolling_mean_season",
      "definition": "Forecast the mean of the most recent cadence-specific seasonal window."
    },
    {
      "id": "ewma_0_2",
      "definition": "Forecast the terminal exponentially weighted mean with fixed alpha 0.2."
    },
    {
      "id": "linear_trend",
      "definition": "Fit an ordinary least-squares line to the most recent two seasonal windows and extrapolate one step."
    },
    {
      "id": "kalman_local_linear_trend",
      "definition": "Use the existing deterministic two-state local-level/local-trend Kalman implementation."
    },
    {
      "id": "autoregressive_ridge",
      "definition": "Fit the existing history-only standardized ridge autoregression with lag min(14, seasonal lag) and lambda 1.0."
    },
    {
      "id": "fft_extrapolation_top5",
      "definition": "Use history-only detrending and the five largest nonzero Fourier modes."
    },
    {
      "id": "uncoupled_harmonic",
      "definition": "Use the same fixed oscillators, history, scaling, and ridge fit as the candidate but advance each phase independently with coupling K=0."
    }
  ],
  "anchored_benchmarks": [
    {
      "id": "eia_grid_wave_champion_20260713",
