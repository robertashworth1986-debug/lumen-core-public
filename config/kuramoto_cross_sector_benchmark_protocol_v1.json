  "source_admission": {
    "explicit_allowlist_only": true,
    "minimum_numeric_rows": 270,
    "reject_duplicate_timestamps": true,
    "reject_nonfinite_values": true,
    "reject_nonmonotonic_after_sort": true,
    "reject_manifest_only_or_named_only_sources": true,
    "excluded_live_breadth_systems_until_repaired": [
      "air_quality",
      "maritime_ais",
      "sports_market",
      "water_hydrology",
      "weather_climate"
    ],
    "exclusion_reason": "Current local snapshots are too thin, contaminated by unrelated files, duplicated, or lack a protocol-matched time-series contract."
  },
  "evaluation": {
    "task": "one_step_ahead_univariate_forecast",
    "history_only_at_each_origin": true,
    "candidate_identity_fixed_before_execution": true,
    "retrospective_sources_are_not_untouched_holdouts": true,
    "primary_metric": "mean_absolute_error",
    "secondary_metrics": [
      "root_mean_squared_error",
      "seasonal_mase",
      "directional_accuracy",
      "runtime_ms"
    ],
    "paired_delta_direction": "baseline_absolute_error_minus_candidate_absolute_error",
    "bootstrap_draws": 4000,
    "bootstrap_seed": 20260726,
    "bootstrap_block_length_rule": "max(2, min(seasonal_lag, floor(sqrt(evaluation_points))))",
    "sign_test_unit": "nonoverlapping block mean paired deltas",
    "multiple_comparison_control": "Holm correction within each source across all declared baselines"
  },
  "promotion_gate": {
    "minimum_evaluation_points": 60,
    "must_beat_every_declared_baseline_on_mean_absolute_error": true,
    "require_positive_block_bootstrap_lower_bound_against_best_baseline": true,
    "require_holm_adjusted_p_at_most": 0.05,
    "minimum_source_wins_for_sector_signal": 2,
    "external_replication_required_for_sector_claim": true,
    "prospective_holdout_required_for_sector_claim": true
  },
  "economic_translation": {
