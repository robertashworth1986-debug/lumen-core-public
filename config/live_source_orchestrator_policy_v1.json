{
  "schema": "live_source_orchestrator_policy.v1",
  "provider_allowlist": [
    "AIRNOW",
    "ALPHAVANTAGE",
    "BEA",
    "BINANCE_PUBLIC",
    "BLS",
    "CENSUS",
    "COINBASE_PUBLIC",
    "COINGECKO_PUBLIC",
    "EIA",
    "EPA_AQS",
    "FINNHUB",
    "FRED",
    "GRANTS_GOV",
    "KRAKEN_PUBLIC",
    "MASSIVE",
    "NASA",
    "NOAA_NCEI",
    "NREL",
    "NWS_PUBLIC",
    "OPEN_METEO_PUBLIC",
    "SAM_GOV",
    "SEC_PUBLIC",
    "THE_ODDS_API",
    "TREASURY_FISCAL_PUBLIC",
    "TWELVE_DATA",
    "USGS_WATER",
    "WEBHOOK",
    "WORLD_BANK_PUBLIC"
  ],
  "limits": {
    "max_concurrency": 4,
    "child_timeout_seconds": 30,
    "request_timeout_seconds": 20,
    "max_retries": 2,
    "retry_base_seconds": 1,
    "max_retry_delay_seconds": 30,
    "default_rate_limit_seconds": 60,
    "circuit_breaker_failures": 3,
    "max_rows": 25,
    "max_child_output_bytes": 65536
  },
  "state_path": "run/live_source_orchestrator/state_v1.json",
  "execution_default": "dry_run",
  "network_default": false,
  "publish_outputs_default": false
}
