      "name": "Harmonic design matrix",
      "implementation_class": "EXACT_STANDARD_METHOD",
      "formal_expression": "X(t) = [1, sin(2*pi*t/p_k), cos(2*pi*t/p_k)] for each registered period p_k",
      "symbols": {"t": "day index [days]", "p_k": "registered period [days]", "X": "dimensionless design matrix"},
      "constants": [{"name": "cycle_angle", "value": "2*pi", "units": "radians", "scope": "trigonometric basis"}],
      "source": {"path": "code/frequency_cluster_truth_gauntlet.py", "symbol": "harmonic_design"},
      "tests": [{"path": "tests/test_scientific_equation_evidence_map.py", "symbol": "test_frequency_equations_match_registered_semantics"}],
